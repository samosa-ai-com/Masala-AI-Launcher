[
  { "name": "credentials in a url", "path": "$.components[0].http.url",
    "widget": { "id": "w", "components": [ { "type": "web_value", "label": "x", "http": { "url": "https://me:secret@api.example.com/p" } } ] } },
  { "name": "password in a query", "path": "$.components[0].http.url",
    "widget": { "id": "w", "components": [ { "type": "web_value", "label": "x", "http": { "url": "http://cam.local/x?user=a&password=b" } } ] } },
  { "name": "templated url", "path": "$.components[0].http.url",
    "widget": { "id": "w", "components": [ { "type": "web_value", "label": "x", "http": { "url": "https://api.example.com/{{storage.city}}" } } ] } },
  { "name": "not http", "path": "$.components[0].http.url",
    "widget": { "id": "w", "components": [ { "type": "web_value", "label": "x", "http": { "url": "file:///sdcard/x.json" } } ] } },
  { "name": "bad json path", "path": "$.components[0].http.jsonPath",
    "widget": { "id": "w", "components": [ { "type": "web_value", "label": "x", "http": { "url": "https://a.example/p", "jsonPath": "$..price" } } ] } },
  { "name": "refresh too often", "path": "$.components[0].http.every",
    "widget": { "id": "w", "components": [ { "type": "web_value", "label": "x", "http": { "url": "https://a.example/p", "every": 5 } } ] } },
  { "name": "background too often", "path": "$.components[0].http.every",
    "widget": { "id": "w", "components": [ { "type": "web_value", "label": "x", "http": { "url": "https://a.example/p", "every": 60, "background": true } } ] } },
  { "name": "http binding without http", "path": "$.components[0].binding.http",
    "widget": { "id": "w", "components": [ { "type": "text", "binding": { "source": "http" } } ] } },
  { "name": "http on another source", "path": "$.components[0].binding.http",
    "widget": { "id": "w", "components": [ { "type": "text", "binding": { "source": "battery", "http": { "url": "https://a.example/p" } } } ] } },
  { "name": "storage without key", "path": "$.components[0].binding.key",
    "widget": { "id": "w", "components": [ { "type": "text", "binding": { "source": "storage" } } ] } },
  { "name": "two videos", "path": "$.components",
    "widget": { "id": "w", "components": [ { "type": "video", "stream": { "sourceId": "a" } }, { "type": "video", "stream": { "sourceId": "b" } } ] } },
  { "name": "video in a row", "path": "$.components[0].children[0]",
    "widget": { "id": "w", "components": [ { "type": "row", "children": [ { "type": "video", "stream": { "sourceId": "a" } } ] } ] } },
  { "name": "nested too deep", "path": "$.components[0].children[0].children[0]",
    "widget": { "id": "w", "components": [ { "type": "row", "children": [ { "type": "column", "children": [ { "type": "row", "children": [ { "type": "text", "text": "x" } ] } ] } ] } ] } },
  { "name": "empty row", "path": "$.components[0].children",
    "widget": { "id": "w", "components": [ { "type": "row", "children": [] } ] } },
  { "name": "snapshot too often", "path": "$.components[0].everySeconds",
    "widget": { "id": "w", "components": [ { "type": "snapshot", "sourceId": "a", "everySeconds": 1 } ] } },
  { "name": "unknown tint", "path": "$.components[0].style.tint",
    "widget": { "id": "w", "components": [ { "type": "text", "text": "x", "style": { "tint": "#ff0000" } } ] } },
  { "name": "shared storage key", "path": "$.components[1].key",
    "widget": { "id": "w", "components": [ { "type": "counter", "key": "n", "label": "A" }, { "type": "counter", "key": "n", "label": "B" } ] } },
  { "name": "text with nothing", "path": "$.components[0]",
    "widget": { "id": "w", "components": [ { "type": "text" } ] } },
  { "name": "too many list rows", "path": "$.components[0].maxRows",
    "widget": { "id": "w", "components": [ { "type": "list", "binding": { "source": "next_event" }, "maxRows": 20 } ] } },
  { "name": "gauge without max", "path": "$.components[0].max",
    "widget": { "id": "w", "components": [ { "type": "gauge", "label": "x", "binding": { "source": "battery" }, "max": 0 } ] } },
  { "name": "size rule outside range", "path": "$.rules[0].effect.rows",
    "widget": { "id": "w", "components": [ { "type": "text", "text": "x" } ], "size": { "min": 1, "default": 1, "max": 2 },
      "rules": [ { "condition": { "type": "charging" }, "effect": { "type": "size", "rows": 4 } } ] } },
  { "name": "no components", "path": "$.components",
    "widget": { "id": "w", "components": [] } }
]
