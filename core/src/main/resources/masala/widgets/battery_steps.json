{
  "id": "battery_steps",
  "name": "Battery and steps",
  "description": "Two rings side by side: battery level and steps against a goal.",
  "widget": {
    "id": "battery-steps",
    "components": [
      {
        "type": "row",
        "children": [
          { "type": "gauge", "label": "Battery", "binding": { "source": "battery" }, "max": 100, "style": { "tint": "green" } },
          { "type": "gauge", "label": "Steps", "binding": { "source": "steps" }, "max": 8000, "style": { "tint": "orange" } }
        ]
      }
    ],
    "size": { "min": 1, "default": 2, "max": 2 }
  }
}
