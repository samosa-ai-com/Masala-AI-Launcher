{
  "id": "stock_ticker",
  "name": "Stock ticker",
  "description": "One quote, refreshed every 15 minutes. Replace the url with your symbol.",
  "category": "Money",
  "widget": {
    "id": "stock_ticker",
    "title": "AAPL",
    "components": [
      {
        "type": "web_value",
        "label": "Quote",
        "http": {
          "url": "https://query1.finance.yahoo.com/v8/finance/chart/AAPL?interval=1d",
          "jsonPath": "$.chart.result[0].meta.regularMarketPrice",
          "every": 900
        },
        "suffix": "USD",
        "style": {
          "emphasis": "large"
        }
      }
    ],
    "size": {
      "min": 1,
      "default": 1,
      "max": 2,
      "minW": 2,
      "defaultW": 2,
      "maxW": 2
    }
  }
}
