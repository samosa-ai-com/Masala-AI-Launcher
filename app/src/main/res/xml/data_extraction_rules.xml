<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: MCP server tokens leave neither by cloud backup nor by device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mcp_servers.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mcp_servers.xml" />
    </device-transfer>
</data-extraction-rules>
