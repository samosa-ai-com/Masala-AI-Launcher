# APK binaries - never commit
extracted-apks/

# Upstream launcher sources: only folder placeholders + clone guide are committed.
# Clone locally on demand (see reference/upstream/README.md). Ignores everything
# inside each project folder except the .gitkeep placeholder.
reference/upstream/*/**
!reference/upstream/*/.gitkeep
# Guard against future nested clones
reference/upstream/*/.git/

# APK analysis output: commit docs + metadata only, never the REDACTED bulk
reference/reversed/*/analysis-output/
reference/reversed/*/analysis-output/

# Gradle / Android Studio
.gradle/
.kotlin/
build/
bin/
local.properties
.env
.idea/
*.iml
captures/
