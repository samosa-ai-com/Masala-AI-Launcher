<?xml version="1.0" encoding="utf-8"?>
<!-- Every entry here is Play-restricted and goes into the readiness report (plan 0.4). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- File finder, security scanner, file paths in other Pro skills -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- APK export from the game and app makers -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- File converter: ffmpeg through Termux -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
    </queries>

    <application>
        <!-- Termux hands a command's result back through a PendingIntent that names this receiver -->
        <receiver
            android:name=".termux.TermuxResultReceiver"
            android:exported="false" />

        <!-- PackageInstaller reports an install session's status here (APK export) -->
        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
